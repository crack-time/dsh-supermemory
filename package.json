{
  "name": "@crack/dsh-supermemory",
  "description": "Local Supermemory reverse proxy for DSH web: exposes the self-hosted memory server's REST API behind a dsh route (/plugins/@crack/dsh-supermemory/api), with a settings card managing base URL + API key.",
  "version": "0.1.0",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "locale",
        "slots"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.client.json && tsdown",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "test": "node --test",
    "test:watch": "node --test --watch"
  },
  "license": "MIT",
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-agent-loop": "0.1.2-alpha.4",
    "@deepseek-ai/dsh-host-webserver": "0.1.2-alpha.4",
    "@deepseek-ai/dsh-llm": "0.1.2-alpha.4",
    "@deepseek-ai/dsh-session": "0.1.2-alpha.4",
    "@deepseek-ai/dsh-settings": "0.1.2-alpha.4",
    "@deepseek-ai/dsh-tools": "0.1.2-alpha.4",
    "@deepseek-ai/dsh-workspace": "0.1.2-alpha.4",
    "@deepseek-ai/schemastery": "^3.18.1",
    "@types/node": "^26.2.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.2-alpha.4",
    "@deepseek-ai/dsh-client-locale": "0.1.2-alpha.4"
  }
}
